PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/goodpanda
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads

# Drone simulation
DRONE_TICK_MS=1000
DRONE_SPEED_MPS=60
DRONE_BATTERY_PER_KM=2
DRONE_MIN_BATTERY=20
DRONE_BATTERY_RESERVE=5
# Fly the empty drone back to the restaurant after a drop-off (true/false)
DRONE_RETURN_TO_BASE=true
DRONE_CHARGING_TICK_MS=2000
DRONE_CHARGE_PERCENT_PER_TICK=10
DRONE_READY_CHARGE=60
DRONE_APPROACHING_ETA_SECONDS=300
# Auto-flag maintenance after this many trips (0 disables)
DRONE_SERVICE_EVERY_TRIPS=25
# Shared secret for hardware telemetry ingest (POST /api/drones/:id/telemetry).
# Leave empty to disable the endpoint.
DRONE_INGEST_KEY=
# A hardware drone with no telemetry for this long is flagged stale in fleet health.
DRONE_STALE_AFTER_SECONDS=120

# Delivery pricing
# Initial delivery fee (Admin can change it later in Settings)
DEFAULT_DELIVERY_FEE=60
# flat = single fee; distance = fee + per-km, capped at max
DELIVERY_FEE_MODE=flat
DELIVERY_FEE_PER_KM=10
DELIVERY_FEE_MAX=300
# Maximum restaurant -> hub distance in km for an order to be placeable (0 disables)
MAX_DELIVERY_DISTANCE_KM=0
# Platform commission (% of order subtotal kept by the platform)
PLATFORM_COMMISSION_PERCENT=10

# Image hosting: set an ImgBB API key (https://api.imgbb.com/) to host uploads on ImgBB.
# Leave empty to store uploads on local disk in UPLOAD_DIR.
IMGBB_API_KEY=

# Web Push (optional). Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@goodpanda.test

# SMS (Twilio) - optional, no-op when not configured. Requires `npm i twilio`.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Online payments (Stripe) - optional, disabled when the secret key is empty.
# The webhook needs the signing secret from `stripe listen` or the dashboard endpoint.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional email (Resend-compatible) - optional, no-op when the key is empty.
EMAIL_API_KEY=
EMAIL_FROM=GoodPanda <receipts@goodpanda.test>
# EMAIL_API_URL=https://api.resend.com/emails

# Structured request logs (set false to silence)
LOG_REQUESTS=true
